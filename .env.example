# heuristic | jev | shadow
# Production: set this in /root/splendor-server/.env on the VPS (or the compose env).
# Deploy writes AI_ENGINE=jev only when the GitHub Actions secret OPENROUTER_API_KEY exists.
AI_ENGINE=heuristic

# Server-only. Required for AI_ENGINE=jev or shadow. Never commit a real key.
OPENROUTER_API_KEY=
