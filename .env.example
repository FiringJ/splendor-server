# heuristic | jev | shadow
# Production: set via Fly secrets (or legacy VPS .env / compose env).
# Deploy writes AI_ENGINE=jev only when the GitHub Actions secret OPENROUTER_API_KEY exists.
AI_ENGINE=heuristic

# Server-only. Required for AI_ENGINE=jev or shadow. Never commit a real key.
OPENROUTER_API_KEY=

# Comma-separated extra browser origins for CORS / Socket.IO (optional).
# Defaults always include https://www.splendor.uno, http://localhost:3000, and *.fly.dev.
# Example for a temporary Fly client:
# CLIENT_ORIGIN=https://your-client.fly.dev
CLIENT_ORIGIN=
